DATABASE_URL="postgresql://username:password@localhost:5432/daniel_retail?schema=public"

# Generate a real one with: openssl rand -hex 32
# Must be at least 32 characters — the server refuses to start otherwise.
JWT_SECRET="replace-this-with-a-real-random-secret-at-least-32-characters-long"

JWT_EXPIRES_IN="7d"
PORT=5000

# Must be your exact frontend URL — wildcard ("*") is rejected in production.
CORS_ORIGIN="http://localhost:3000"

NODE_ENV="development"

# Used to build the password reset link sent in emails.
FRONTEND_URL="http://localhost:3000"

# Optional — if unset, reset emails are logged to the console instead of sent
# (useful for local dev). Get a key from https://resend.com to send real emails.
RESEND_API_KEY=""
EMAIL_FROM="no-reply@yourdomain.com"

# Optional — enables product image upload from the dashboard. Get free
# credentials from https://cloudinary.com. Without these set, the upload
# button is disabled and you can still paste an image URL manually.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
